# Copy this file to .env and fill in your key. .env is git-ignored, never commit it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Leave empty to return fake results (no API calls). Set to 1 to force mock mode.
MOCK_LLM=
# Optional: your extension's id (chrome://extensions, Developer mode). Locks CORS to it.
EXTENSION_ID=
# Set to 1 to turn on the interactive API docs at /docs (off by default).
ENABLE_DOCS=
